{
  "name": "@redwoodjs/starter",
  "version": "1.0.0",
  "description": "A bare-bones RedwoodSDK starter",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:prod": "CLOUDFLARE_ENV=production vite build",
    "dev": "vite dev",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release:staging": "npm run clean:vite && npm run build:staging && wrangler deploy --env staging",
    "release:prod": "npm run clean:vite && npm run build:prod && wrangler deploy --env production",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false --env production",
    "check": "npm run generate && npm run types",
    "types": "tsc"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "rwsdk": "1.0.0-beta.47",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.17.1",
    "@cloudflare/workers-types": "4.20260103.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "~24.5.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "^4.1.7",
    "wrangler": "4.54.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
